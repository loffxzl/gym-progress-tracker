# Production Environment Configuration Template (Backend)
PORT=5001
NODE_ENV=production

# PostgreSQL Connection String (Production Database)
DATABASE_URL="postgresql://gym_user:secure_production_password@postgres:5432/gym_tracker?schema=public&sslmode=prefer"

# JWT Authentication Secrets
JWT_SECRET="replace-with-a-random-64-character-production-secret-key"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (Production Domain)
CORS_ORIGIN="https://gymtracker.app"
